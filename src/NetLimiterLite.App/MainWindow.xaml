<Window x:Class="NetLimiterLite.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetLimiterLite" Height="480" Width="760">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,8" FontSize="16" FontWeight="Bold"
                   Text="Processes with active network connections" />

        <GroupBox Grid.Row="1" Header="Destiny 2 Priority Mode" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="6">
                <CheckBox x:Name="Destiny2PriorityCheckBox" Content="Enable" VerticalAlignment="Center"
                          Checked="Destiny2PriorityCheckBox_Changed" Unchecked="Destiny2PriorityCheckBox_Changed" />
                <TextBlock Text="Background cap while Destiny 2 / Bungie launcher is running - Down (KB/s):"
                           Margin="16,0,4,0" VerticalAlignment="Center" />
                <TextBox x:Name="Destiny2DownCapTextBox" Width="60" Text="200" />
                <TextBlock Text="Up (KB/s):" Margin="12,0,4,0" VerticalAlignment="Center" />
                <TextBox x:Name="Destiny2UpCapTextBox" Width="60" Text="50" />
                <TextBlock x:Name="Destiny2StatusText" Margin="16,0,0,0" Foreground="Gray"
                           VerticalAlignment="Center" Text="Applies to every other process only while Destiny 2 is active." />
            </StackPanel>
        </GroupBox>

        <DataGrid Grid.Row="2" x:Name="ProcessGrid" AutoGenerateColumns="False"
                  ItemsSource="{Binding Rows}" CanUserAddRows="False" CanUserDeleteRows="False"
                  IsReadOnly="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" IsReadOnly="True" Width="180" />
                <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" IsReadOnly="True" Width="60" />
                <DataGridTextColumn Header="Down (KB/s)" Binding="{Binding DownloadKBps, StringFormat=F1}" IsReadOnly="True" Width="100" />
                <DataGridTextColumn Header="Up (KB/s)" Binding="{Binding UploadKBps, StringFormat=F1}" IsReadOnly="True" Width="100" />
                <DataGridTextColumn Header="Down Limit (KB/s, blank = unlimited)" Binding="{Binding DownloadLimitKBps}" Width="180" />
                <DataGridTextColumn Header="Up Limit (KB/s, blank = unlimited)" Binding="{Binding UploadLimitKBps}" Width="180" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="ApplyButton" Content="Apply Limits" Width="120" Margin="0,0,8,0" Click="ApplyButton_Click" />
            <Button x:Name="PauseAllButton" Content="Pause All Throttling" Width="150" Click="PauseAllButton_Click" />
            <TextBlock x:Name="StatusText" Margin="16,4,0,0" Foreground="Gray"
                       Text="Run as Administrator required for packet diversion (WinDivert)." />
        </StackPanel>
    </Grid>
</Window>
